# Server-only. Never prefix these with NEXT_PUBLIC_.
GATEWAY_BASE_URL=https://ai.safenetvpn.dedyn.io
CLIPROXY_API_KEY=replace-with-server-side-key
HOME_GATEWAY_SECRET=replace-with-server-side-secret

# The hardened Caddy origin exposes only POST /v1/responses.
# DEFAULT_GATEWAY_MODEL is preferred. GATEWAY_MODEL remains supported for compatibility.
DEFAULT_GATEWAY_MODEL=gpt-5.6-luna
ALLOWED_GATEWAY_MODELS=gpt-5.6-luna
VISION_GATEWAY_MODELS=gpt-5.6-luna
REASONING_GATEWAY_MODELS=gpt-5.6-luna

# Public deployment controls.
CHAT_ENABLED=true
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=300000
